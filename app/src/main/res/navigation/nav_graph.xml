<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="ru.semen.fishingspot.auth.LoginFragment"
        android:label="LoginFragment">
        <action
            android:id="@+id/action_login_to_mainTabs"
            app:destination="@id/mainTabsFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/mainTabsFragment"
        android:name="ru.semen.fishingspot.fragment.MainTabsFragment"
        android:label="Главная">
        <action
            android:id="@+id/action_mainTabs_to_addPoint"
            app:destination="@id/addPointFragment" />
        <action
            android:id="@+id/action_map_to_details"
            app:destination="@id/spotDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/sendFishingSignalFragment"
        android:name="ru.semen.fishingspot.messages.SendFishingSignalFragment"
        android:label="Выбор местоположения">

    </fragment>

    <fragment
        android:id="@+id/addPointFragment"
        android:name="ru.semen.fishingspot.map.point.AddPointFragment"
        android:label="Новая точка">
        <action
            android:id="@+id/action_addPoint_to_refineLocation"
            app:destination="@id/refineLocationFragment" />
    </fragment>

    <fragment
        android:id="@+id/refineLocationFragment"
        android:name="ru.semen.fishingspot.map.point.RefineLocationFragment"
        android:label="Уточнение точки">
        <action
            android:id="@+id/action_refine_to_tabs"
            app:destination="@id/mainTabsFragment"
            app:popUpTo="@id/mainTabsFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <!-- ✅ КАРТА ДРУГА С СОБСТВЕННЫМ ЭКШЕНОМ К ДЕТАЛЯМ -->
    <fragment
        android:id="@+id/friendMapFragment"
        android:name="ru.semen.fishingspot.friends.FriendMapFragment"
        android:label="FriendMapFragment">
        <action
            android:id="@+id/action_friend_map_to_details"
            app:destination="@id/spotDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/spotDetailsFragment"
        android:name="ru.semen.fishingspot.map.point.SpotDetailsFragment"
        android:label="Детали точки" />

    <fragment
        android:id="@+id/feedFragment"
        android:name="ru.semen.fishingspot.feed.FeedFragment"
        android:label="Лента точек" />

</navigation>