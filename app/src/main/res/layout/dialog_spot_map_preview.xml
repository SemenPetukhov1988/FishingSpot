<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Ручка шторки -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@android:color/darker_gray" />

    <!-- Заголовок -->
    <TextView
        android:id="@+id/tvMapDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Расположение точки"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"/>

    <!-- ✅ ЧИСТЫЙ КОНТЕЙНЕР ДЛЯ КАРТЫ (БЕЗ СТАТИЧНОГО МАРКЕРА) -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_marginHorizontal="16dp"
        android:background="#EAEFF5">

        <!-- Временная заглушка, пока не подключена карта -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🗺️ Загрузка карты..."
            android:textSize="14sp"
            android:textColor="#818C99"
            android:gravity="center"/>

        <!-- Сюда программно добавится MapView/Fragment и маркер -->
    </FrameLayout>

    <!-- Кнопки действий внизу шторки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelMapPreview"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Закрыть"
            android:textColor="#818C99"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmSaveFromMap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅ Сохранить к себе"
            android:layout_marginStart="8dp"
            app:backgroundTint="#0288D1"
            app:cornerRadius="12dp"/>
    </LinearLayout>

</LinearLayout>