<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Заголовок с кнопкой закрытия -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ответить на вопрос"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"/>

        <ImageButton
            android:id="@+id/btnCloseReply"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Закрыть"/>
    </LinearLayout>

    <!-- Контейнер для карты -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#EAEFF5"/>

    <!-- Поле ввода ответа -->
    <EditText
        android:id="@+id/etReplyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:hint="Напишите ваш ответ..."
        android:minHeight="100dp"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:background="@android:drawable/edit_text"
        android:padding="12dp"/>

    <!-- Кнопка отправить -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSendReply"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:text="📤 Отправить ответ"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:backgroundTint="#1976D2"/>

</LinearLayout>