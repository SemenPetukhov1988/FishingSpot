<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="20dp">

    <!-- Декоративная полоска сверху (индикатор шторки) -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
         />

    <!-- Заголовок -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎣 Друг сходил на рыбалку"
        android:textSize="13sp"
        android:textColor="#4C9AFF"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:letterSpacing="0.05" />

    <!-- Название точки -->
    <TextView
        android:id="@+id/tvPreviewName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        tools:text="Озеро Х (Щука)" />

    <!-- Автор и дата -->
    <TextView
        android:id="@+id/tvPreviewAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp"
        android:textColor="#888888"
        tools:text="Добавил Семён • 12 окт 2026" />

    <!-- Разделитель -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#EEEEEE" />

    <!-- Описание -->
    <TextView
        android:id="@+id/tvPreviewDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="#333333"
        android:lineSpacingMultiplier="1.3"
        tools:text="Клёвая рыбалка, щука брала на воблер. Глубина около 3 метров, коряжник." />

    <!-- 🗺️ ЗАГЛУШКА ДЛЯ КАРТЫ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="16dp"
        android:background="#E8F4F8"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="️"
            android:textSize="40sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Карта с маркером"
            android:textSize="14sp"
            android:textColor="#4C9AFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Будет добавлена позже"
            android:textSize="12sp"
            android:textColor="#888888" />
    </LinearLayout>

    <!-- 📷 ЗАГЛУШКА ДЛЯ ФОТО -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="12dp"
        android:background="#F5F5F5"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷"
            android:textSize="36sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Фото точки"
            android:textSize="14sp"
            android:textColor="#666666"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Будет добавлено позже"
            android:textSize="12sp"
            android:textColor="#999999" />
    </LinearLayout>

    <!-- Блок с доп. информацией -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <!-- Вес улова -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚖️ Улов"
                android:textSize="11sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvPreviewWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000000"
                tools:text="2.5 кг" />
        </LinearLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <!-- Координаты -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Координаты"
                android:textSize="11sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvPreviewCoords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#000000"
                tools:text="64.56, 40.55" />
        </LinearLayout>
    </LinearLayout>

    <!-- Кнопка Сохранить -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPreviewSave"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:text="💾 Сохранить в мой дневник"
        android:textAllCaps="false"
        android:textSize="15sp"
        app:backgroundTint="#4CAF50"
        app:cornerRadius="12dp" />

    <!-- Кнопка отмены (опционально, для удобства) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPreviewCancel"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:text="Удалить"
        android:textAllCaps="false"
        android:textColor="#888888"
        android:textSize="13sp" />

</LinearLayout>