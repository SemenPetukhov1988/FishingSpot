<?xml version="1.0" encoding="utf-8"?>
<!-- БЕЗ КАРТОЧКИ И РАМОК. ФОН ЗАДАЁТ РОДИТЕЛЬ (BottomSheet) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ЗАГОЛОВОК ШЕЙТА -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Какое сообщение направить?"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:padding="16dp" />

    <!-- Тонкий разделитель под заголовком -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E7E8EC"/>

    <!-- ВАРИАНТ 1: Я НА РЫБАЛКЕ -->
    <LinearLayout
        android:id="@+id/btnOnFishing"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"

            app:tint="#0288D1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎣 Я сейчас на рыбалке"
            android:textSize="15sp"
            android:textColor="#222222"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <!-- Разделитель между пунктами -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E7E8EC"/>

    <!-- ВАРИАНТ 2: СОБИРАЮСЬ НА РЫБАЛКУ -->
    <LinearLayout
        android:id="@+id/btnGoingFishing"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"

            app:tint="#0288D1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚗 Собираюсь на рыбалку"
            android:textSize="15sp"
            android:textColor="#222222"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <!-- Разделитель между пунктами -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E7E8EC"/>

    <!-- ВАРИАНТ 3: ГДЕ ПОРЫБАЧИТЬ -->
    <LinearLayout
        android:id="@+id/btnRequestSpot"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"

            app:tint="#0288D1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❓ Где порыбачить"
            android:textSize="15sp"
            android:textColor="#222222"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

</LinearLayout>