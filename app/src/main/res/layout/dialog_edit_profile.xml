<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#E3F2FD"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp">

    <!-- ✅ УБРАНО gravity="center_horizontal", чтобы дети растягивались -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Кнопка закрытия (крестик) -->
        <ImageView
            android:id="@+id/btnCloseDialog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:src="@drawable/close_24dp_000000_fill0_wght400_grad0_opsz24"
            android:contentDescription="Закрыть"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"/>

        <!-- Крупная аватарка-заглушка -->
        <!-- ✅ layout_gravity="center" центрирует саму картинку, но не сжимает её -->
        <ImageView
            android:id="@+id/ivProfileAvatarLarge"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_avatar_shape"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:src="@drawable/add_a_photo_24dp_000000_fill0_wght400_grad0_opsz24__1_"
            />

        <!-- Поле никнейма -->
        <!-- ✅ ЯВНОЕ match_parent для растягивания на всю ширину -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Никнейм"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Семенчик"
                android:maxLines="1"
                android:inputType="textPersonName"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Кнопка сохранения -->
        <!-- ✅ ЯВНОЕ match_parent и фиксированная высота для пропорций -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="Сохранить изменения"
            android:textAllCaps="false"
            android:textSize="16sp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>