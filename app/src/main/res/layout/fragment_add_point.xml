<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ✅ 1. ШАПКА С КНОПКОЙ НАЗАД -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Кнопка назад (возвращена для binding.btnBack) -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/back"
                android:contentDescription="Назад"
                app:tint="#222222" />

            <!-- Заголовок по центру -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Новая точка"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:gravity="center" />

            <!-- Пустой spacer справа для симметрии -->
            <View
                android:layout_width="48dp"
                android:layout_height="48dp" />
        </LinearLayout>

        <!-- ✅ 2. БЛОК ФОТО (Без карточки, как в ленте) -->
        <FrameLayout
            android:id="@+id/cardPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0F2F5"
            android:minHeight="160dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <!-- Плейсхолдер -->
            <LinearLayout
                android:id="@+id/layoutPhotoPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivPhotoIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/add_a_photo_24dp_000000_fill0_wght400_grad0_opsz24__1_"
                    app:tint="#B0BEC5"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvPhotoHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Добавить фото"
                    android:textSize="14sp"
                    android:textColor="#818C99" />
            </LinearLayout>

            <!-- Превью фото -->
            <ImageView
                android:id="@+id/ivPhotoPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:maxHeight="400dp" />

            <!-- Кнопка удаления -->
            <ImageButton
                android:id="@+id/btnRemovePhoto"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/no_accounts_24dp_000000_fill0_wght400_grad0_opsz24"
                android:contentDescription="Удалить фото"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:visibility="gone"
                app:tint="#EF4444"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </FrameLayout>

        <!-- ✅ 3. ВИДИМОСТЬ ТОЧКИ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Кто видит эту точку"
            android:textSize="14sp"
            android:textColor="#818C99"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupVisibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVisibilityPrivate"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🔒 Личная"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:strokeColor="#0288D1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVisibilityFriends"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="👥 Друзья"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:strokeColor="#0288D1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVisibilityPublic"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🌍 Публичная"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:strokeColor="#0288D1" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- ✅ 4. ПОЛЯ ВВОДА -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Название места"
            app:boxStrokeColor="#0288D1"
            app:hintTextColor="#0288D1"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSpotName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="50" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutFishingDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Дата рыбалки"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/calendar_month_24dp_000000_fill0_wght400_grad0_opsz24"
            app:boxStrokeColor="#0288D1"
            app:hintTextColor="#0288D1"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp"
            android:layout_marginBottom="20dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFishingDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:focusable="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ✅ 5. ЧИПСЫ И ВЫБОР -->
        <!-- Способ ловли -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Способ ловли"
            android:textSize="14sp"
            android:textColor="#818C99"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLocationShore"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🏕️ С берега"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:strokeColor="#0288D1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLocationBoat"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🚤 С лодки"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:strokeColor="#0288D1" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Снасти -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Снасти"
            android:textSize="14sp"
            android:textColor="#818C99"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTackle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="20dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTackleSpinner"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Спиннинг"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:checkedIconTint="#0288D1"
                app:chipStrokeColor="#0288D1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTackleFeeder"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Фидер"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:checkedIconTint="#0288D1"
                app:chipStrokeColor="#0288D1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTackleFloat"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Поплавок"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:checkedIconTint="#0288D1"
                app:chipStrokeColor="#0288D1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTackleWinter"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Зимняя"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:checkedIconTint="#0288D1"
                app:chipStrokeColor="#0288D1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTackleOther"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Другое"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:checkedIconTint="#0288D1"
                app:chipStrokeColor="#0288D1" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Наживка -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Наживка / Приманка"
            android:textSize="14sp"
            android:textColor="#818C99"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupBait"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="20dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBaitWorm"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Червь"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:checkedIconTint="#0288D1"
                app:chipStrokeColor="#0288D1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBaitMaggot"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Опарыш"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:checkedIconTint="#0288D1"
                app:chipStrokeColor="#0288D1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBaitBloodworm"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Мотыль"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:checkedIconTint="#0288D1"
                app:chipStrokeColor="#0288D1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBaitLure"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Блесна/Воблер"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:checkedIconTint="#0288D1"
                app:chipStrokeColor="#0288D1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBaitOther"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Другое"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:checkedIconTint="#0288D1"
                app:chipStrokeColor="#0288D1" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Вид рыбы -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Преимущественно в улове"
            android:textSize="14sp"
            android:textColor="#818C99"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="20dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPike"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Щука"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:checkedIconTint="#0288D1"
                app:chipStrokeColor="#0288D1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPerch"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Окунь"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:checkedIconTint="#0288D1"
                app:chipStrokeColor="#0288D1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipZander"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Судак"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:checkedIconTint="#0288D1"
                app:chipStrokeColor="#0288D1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBream"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Лещ"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:checkedIconTint="#0288D1"
                app:chipStrokeColor="#0288D1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRoach"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Плотва"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:checkedIconTint="#0288D1"
                app:chipStrokeColor="#0288D1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOtherFish"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Другое"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:checkedIconTint="#0288D1"
                app:chipStrokeColor="#0288D1" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Поле для другой рыбы -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutOtherFish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите вид рыбы"
            app:boxStrokeColor="#0288D1"
            app:hintTextColor="#0288D1"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOtherFish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Вес улова -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Вес улова"
            android:textSize="14sp"
            android:textColor="#818C99"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWeight1"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="До 1 кг"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:strokeColor="#0288D1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWeight2"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="1–5 кг"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:strokeColor="#0288D1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWeight3"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="> 5 кг"
                android:textSize="13sp"
                android:textColor="#0288D1"
                app:strokeColor="#0288D1" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- ✅ 6. ОПИСАНИЕ -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Описание места"
            app:boxStrokeColor="#0288D1"
            app:hintTextColor="#0288D1"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Координаты сохранены автоматически"
            android:textSize="12sp"
            android:textColor="#818C99"
            android:layout_marginBottom="24dp" />

        <!-- ✅ 7. КНОПКА СОХРАНИТЬ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="Сохранить точку"
            android:textSize="14sp"
            android:textColor="#0288D1"
            app:cornerRadius="18dp"
            app:strokeColor="#0288D1"
            app:strokeWidth="1dp"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/mymapblack"
            app:iconTint="#0288D1"
            app:iconGravity="textStart"
            android:layout_marginBottom="16dp" />

        <!-- Тонкий разделитель внизу -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E7E8EC"/>

    </LinearLayout>
</ScrollView>