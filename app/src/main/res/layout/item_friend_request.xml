<?xml version="1.0" encoding="utf-8"?>
<!-- БЕЗ КАРТОЧКИ И РАМОК. ФОН ЗАДАЁТ РОДИТЕЛЬ (RecyclerView) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_marginBottom="12dp">

    <!-- 1. ШАПКА УВЕДОМЛЕНИЯ (АВАТАР + ИМЯ + ВРЕМЯ) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Аватар с первой буквой имени (сохранен оригинальный стиль TextView) -->
        <TextView
            android:id="@+id/tvFriendReqAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="С" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvFriendReqAuthorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#222222"
                tools:text="Семёнка" />

            <TextView
                android:id="@+id/tvFriendReqTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#818C99"
                android:layout_marginTop="2dp"
                tools:text="5 мин назад" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. ТЕКСТ ЗАПРОСА (СИНИЙ АКЦЕНТ) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:text="🤝 Хочет добавить вас в друзья"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#0288D1" />

    <!-- 3. ПАНЕЛЬ ДЕЙСТВИЙ (УНИФИЦИРОВАННАЯ СТРУКТУРА) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical">

        <!-- Кнопка "Отклонить" -->
        <LinearLayout
            android:id="@+id/btnDeclineFriend"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/no_accounts_24dp_000000_fill0_wght400_grad0_opsz24"
                app:tint="#F44336"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Отклонить"
                android:textSize="14sp"
                android:textColor="#F44336"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Спейсер для разделения кнопок -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- Кнопка "Принять" -->
        <LinearLayout
            android:id="@+id/btnAcceptFriend"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/add_24dp_000000_fill0_wght400_grad0_opsz24__1_"
                app:tint="#4CAF50"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Принять"
                android:textSize="14sp"
                android:textColor="#4CAF50"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Тонкий разделитель внизу (как в образце) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E7E8EC"/>

</LinearLayout>