<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAEFF5">

    <!-- Прогресс-бар загрузки -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Баннер оффлайна -->
    <TextView
        android:id="@+id/tvOfflineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📥 Нет интернета. Показаны сохраненные данные"
        android:textSize="13sp"
        android:textColor="#D97706"
        android:textStyle="bold"
        android:background="#FEF3C7"
        android:padding="10dp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- ✅ УБРАН paddingTop, НЕТ ПУСТОТЫ НАВЕРХУ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. ШАПКА ПОСТА (АВТОР + ДАТА) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:background="#FFFFFF">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Назад"
                    app:tint="#818C99"
                    android:layout_marginEnd="12dp"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivAuthorAvatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/account_circle_24dp"
                    app:shapeAppearanceOverlay="@style/CircleImageView"
                    android:background="#E1E3E6" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvAuthorName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Автор точки"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#222222" />

                    <TextView
                        android:id="@+id/tvFishingDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 Дата рыбалки"
                        android:textSize="13sp"
                        android:textColor="#818C99"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvSpotName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Название места"
                        android:textSize="14sp"
                        android:textColor="#222222"
                        android:layout_marginTop="4dp"
                        android:maxLines="2"
                        android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 2. ФОТОГРАФИЯ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF">

                <ImageView
                    android:id="@+id/ivSpotPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:maxHeight="500dp"
                    android:background="#F0F2F5"/>

                <ImageView
                    android:id="@+id/ivPhotoPlaceholder"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:src="@drawable/add_a_photo_24dp_000000_fill0_wght400_grad0_opsz24__1_"
                    app:tint="#B0BEC5"
                    android:visibility="visible"/>
            </FrameLayout>

            <!-- 3. ПАНЕЛЬ ДЕЙСТВИЙ (ЛАЙК + КОММЕНТАРИИ) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:gravity="center_vertical"
                android:background="#FFFFFF">

                <LinearLayout
                    android:id="@+id/layoutLike"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/thumb_up_24dp_000000_fill0_wght400_grad0_opsz24"
                        app:tint="#818C99"/>

                    <TextView
                        android:id="@+id/tvLikesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="14sp"
                        android:textColor="#818C99"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutComments"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:layout_marginStart="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/comment_24dp_000000_fill0_wght400_grad0_opsz24"
                        app:tint="#818C99"/>

                    <TextView
                        android:id="@+id/tvCommentsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Обсуждение"
                        android:textSize="14sp"
                        android:textColor="#818C99"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            </LinearLayout>

            <!-- Тонкий разделитель -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E7E8EC"
                android:layout_marginBottom="16dp"/>

            <!-- 4. ОПИСАНИЕ И ДЕТАЛИ УЛОВА (ОБЪЕДИНЕНЫ) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="16dp">

                <!-- Вес улова теперь здесь -->
                <TextView
                    android:id="@+id/tvCatchWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚖️ Улов не указан"
                    android:textSize="14sp"
                    android:textColor="#0288D1"
                    android:textStyle="bold"
                    android:background="#E3F2FD"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Описание места -->
                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Описание места..."
                    android:textSize="15sp"
                    android:textColor="#222222"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <!-- 5. КНОПКИ УПРАВЛЕНИЯ ТОЧКОЙ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="32dp">

                <!-- Навигация (полная ширина) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNavigate"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="📍 Добраться до места"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    app:icon="@drawable/alt_route_24dp_000000_fill0_wght400_grad0_opsz24"
                    app:iconGravity="textStart"
                    app:iconTint="#FFFFFF"
                    app:backgroundTint="#0288D1"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="12dp" />

                <!-- ✅ ГОРИЗОНТАЛЬНЫЕ КНОПКИ (ИСПРАВЛЕННАЯ ВЫСОТА) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleFriendsVisibility"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="👥 Показать точку друзьям"
                        android:textSize="13sp"
                        android:maxLines="2"
                        android:minHeight="56dp"
                        app:strokeColor="#0288D1"
                        android:textColor="#0288D1"
                        app:cornerRadius="12dp"
                        android:layout_marginEnd="8dp"
                        android:visibility="gone"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTogglePublicMap"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌍 Показать на публичной карте"
                        android:textSize="13sp"
                        android:maxLines="2"
                        android:minHeight="56dp"
                        app:strokeColor="#0288D1"
                        android:textColor="#0288D1"
                        app:cornerRadius="12dp"
                        android:layout_marginStart="8dp"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- Избранное -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveToLocal"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="💾 Сохранить к себе"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    app:icon="@drawable/save_24dp_000000_fill0_wght400_grad0_opsz24"
                    app:iconGravity="textStart"
                    app:iconTint="#0288D1"
                    android:textColor="#0288D1"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"/>

                <!-- Удаление -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteSpot"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="️ Удалить точку"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    app:icon="@drawable/no_accounts_24dp_000000_fill0_wght400_grad0_opsz24"
                    app:iconGravity="textStart"
                    app:iconTint="#E53935"
                    android:textColor="#E53935"
                    android:layout_gravity="center_horizontal"
                    android:visibility="gone"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>