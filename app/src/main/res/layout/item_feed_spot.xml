<?xml version="1.0" encoding="utf-8"?>
<!-- БЕЗ КАРТОЧКИ, БЕЗ РАМОК. ФОН ЗАДАЁТ РОДИТЕЛЬ (FragmentFeed) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_marginBottom="12dp">

    <!-- 1. ШАПКА ПОСТА (АВТОР + ДАТА + НАЗВАНИЕ) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivFeedAuthorAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:src="@drawable/account_circle_24dp"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            android:background="#E1E3E6" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvFeedAuthorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Автор точки"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <TextView
                android:id="@+id/tvFeedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Дата рыбалки"
                android:textSize="13sp"
                android:textColor="#818C99"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvFeedSpotName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Название места"
                android:textSize="14sp"
                android:textColor="#222222"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 2. ФОТОГРАФИЯ (БЕЗ РАМОК И ТЕНЕЙ) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0F2F5">

        <ImageView
            android:id="@+id/ivFeedPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:maxHeight="400dp"/>

        <ImageView
            android:id="@+id/ivFeedPhotoPlaceholder"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/add_a_photo_24dp_000000_fill0_wght400_grad0_opsz24__1_"
            app:tint="#B0BEC5"
            android:visibility="visible"/>
    </FrameLayout>

    <!-- 3. ПАНЕЛЬ ДЕЙСТВИЙ (СИНЯЯ КАК В ДЕТАЛЯХ ТОЧКИ) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical">

        <!-- Лайк (заглушка для будущей логики) -->
        <LinearLayout
            android:id="@+id/layoutFeedLike"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/thumb_up_24dp_000000_fill0_wght400_grad0_opsz24"
                app:tint="#0288D1"/>

            <TextView
                android:id="@+id/tvFeedLikesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="14sp"
                android:textColor="#0288D1"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Комментарии -->
        <LinearLayout
            android:id="@+id/btnFeedComments"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:layout_marginStart="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/comment_24dp_000000_fill0_wght400_grad0_opsz24"
                app:tint="#0288D1"/>

            <TextView
                android:id="@+id/tvFeedCommentsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Обсуждение"
                android:textSize="14sp"
                android:textColor="#0288D1"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Спейсер для разделения -->
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <!-- ✅ КНОПКА "ПОСМОТРЕТЬ НА КАРТЕ" (ВМЕСТО СОХРАНИТЬ) -->
        <LinearLayout
            android:id="@+id/btnViewOnMap"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/mymapblack"
                app:tint="#0288D1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="На карте"
                android:textSize="14sp"
                android:textColor="#0288D1"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Тонкий разделитель -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E7E8EC"/>

    <!-- 4. ОПИСАНИЕ И ДЕТАЛИ (КАК В ДЕТАЛЯХ ТОЧКИ) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Вес улова -->
        <TextView
            android:id="@+id/tvFeedWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚖️ Улов не указан"
            android:textSize="14sp"
            android:textColor="#0288D1"
            android:textStyle="bold"
            android:background="#E3F2FD"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            app:cornerRadius="8dp"
            android:layout_marginBottom="12dp"/>

        <!-- Описание / Рыба -->
        <TextView
            android:id="@+id/tvFeedFish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🐟 Не указана"
            android:textSize="15sp"
            android:textColor="#222222"
            android:lineSpacingExtra="4dp" />

        <!-- Координаты (мелким серым внизу) -->
        <TextView
            android:id="@+id/tvFeedCoordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" Координаты"
            android:textSize="12sp"
            android:textColor="#818C99"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

</LinearLayout>