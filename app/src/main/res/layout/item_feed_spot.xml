<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_marginBottom="12dp">

    <!-- 1. ШАПКА -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivFeedAuthorAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:src="@drawable/account_circle_24dp"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            android:background="#E1E3E6" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvFeedAuthorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Семен Иванов"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <TextView
                android:id="@+id/tvFeedSpotName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Лесное озеро у плотины"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvFeedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 07.11.2026"
                android:textSize="13sp"
                android:textColor="#818C99"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. МЕТА-ИНФОРМАЦИЯ (СНАСТИ) -->
    <TextView
        android:id="@+id/tvFeedMetaInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:textSize="14sp"
        android:textColor="#444444"
        android:lineSpacingExtra="2dp"
        android:visibility="gone" />

    <!-- 3. ФОТО -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0F2F5">

        <ImageView
            android:id="@+id/ivFeedPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:maxHeight="400dp"/>

        <ImageView
            android:id="@+id/ivFeedPhotoPlaceholder"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/add_a_photo_24dp_000000_fill0_wght400_grad0_opsz24__1_"
            app:tint="#B0BEC5"
            android:visibility="visible"/>
    </FrameLayout>

    <!-- ✅ 4. ТЕКСТ ПОСТА (ПОД ФОТО) -->
    <TextView
        android:id="@+id/tvFeedUserText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:paddingTop="12dp"
        android:textSize="15sp"
        android:textColor="#222222"
        android:lineSpacingExtra="4dp"
        android:visibility="gone" />

    <!-- 5. ПАНЕЛЬ ДЕЙСТВИЙ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/layoutFeedLike"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/thumb_up_24dp_000000_fill0_wght400_grad0_opsz24"
                app:tint="#0288D1"/>
            <TextView
                android:id="@+id/tvFeedLikesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="14sp"
                android:textColor="#0288D1"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnFeedComments"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:layout_marginStart="16dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/comment_24dp_000000_fill0_wght400_grad0_opsz24"
                app:tint="#0288D1"/>
            <TextView
                android:id="@+id/tvFeedCommentsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Обсуждение"
                android:textSize="14sp"
                android:textColor="#0288D1"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <LinearLayout
            android:id="@+id/btnViewOnMap"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/mymapblack"
                app:tint="#0288D1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="На карте"
                android:textSize="14sp"
                android:textColor="#0288D1"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E7E8EC"/>

</LinearLayout>