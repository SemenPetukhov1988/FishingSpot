<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Ручка шторки -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@android:color/darker_gray" />

    <!-- Заголовок и счетчик -->
    <TextView
        android:id="@+id/tvCommentsCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:text="💬 Комментарии"/>

    <!-- Список комментариев -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvComments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="300dp"
        android:maxHeight="500dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"/>

    <!-- Пустое состояние -->
    <TextView
        android:id="@+id/tvEmptyComments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:gravity="center"
        android:text="Пока нет комментариев.\nБудьте первым!"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"/>

    <!-- ✅ ПЛАШКА РЕЖИМА ОТВЕТА (Добавлена) -->
    <LinearLayout
        android:id="@+id/layoutReplyIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#E3F2FD"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvReplyingTo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#0288D1"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/btnCancelReply"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/no_accounts_24dp_000000_fill0_wght400_grad0_opsz24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Отмена ответа"
            app:tint="#0288D1"/>
    </LinearLayout>

    <!-- Поле ввода комментария -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="?attr/colorSurfaceVariant">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCommentInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Написать комментарий..."
            android:maxLines="3"
            android:inputType="textMultiLine|textCapSentences"
            android:background="@android:color/transparent"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendComment"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➤"
            android:textSize="20sp"
            app:iconTint="?attr/colorPrimary"/>

    </LinearLayout>

</LinearLayout>