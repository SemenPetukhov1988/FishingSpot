<?xml version="1.0" encoding="utf-8"?>
<!-- БЕЗ КАРТОЧКИ И РАМОК. ФОН ЗАДАЁТ РОДИТЕЛЬ (RecyclerView) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_marginBottom="12dp">

    <!-- 1. ШАПКА УВЕДОМЛЕНИЯ (АВАТАР + ИМЯ + ВРЕМЯ) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivSignalAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:src="@drawable/account_circle_24dp"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            android:background="#E1E3E6" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Семен сейчас на рыбалке!"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="только что"
                android:textSize="13sp"
                android:textColor="#818C99"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. ПАНЕЛЬ ДЕЙСТВИЙ (СИНЯЯ КАК В ЛЕНТЕ) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical">

        <!-- Кнопка "Показать на карте" -->
        <LinearLayout
            android:id="@+id/btnShowOnMap"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/mymapblack"
                app:tint="#0288D1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="На карте"
                android:textSize="14sp"
                android:textColor="#0288D1"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Спейсер для разделения кнопок -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- Кнопка "Хорошей рыбалки!" -->
        <LinearLayout
            android:id="@+id/btnWishGoodFishing"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/thumb_up_24dp_000000_fill0_wght400_grad0_opsz24"
                app:tint="#0288D1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Хорошей рыбалки!"
                android:textSize="14sp"
                android:textColor="#0288D1"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Тонкий разделитель внизу (как в ленте) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E7E8EC"/>

</LinearLayout>